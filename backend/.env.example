# Trading System Backend Configuration
PROJECT_NAME="Algorithmic Trading Backend"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, easily upgradable to PostgreSQL)
DATABASE_URL="sqlite:///./trading_system.db"

# Angel One SmartAPI Credentials (Live Mode)
SMART_API_KEY=""
SMART_API_CLIENT_CODE=""
SMART_API_PASSWORD=""
SMART_API_TOTP_KEY=""
SMART_API_FEED_TOKEN=""

# Paper Trading Defaults
INITIAL_PAPER_WALLET_BALANCE=1000000.0

# WhatsApp Alerts Configuration (Optional Webhook or Direct)
WHATSAPP_ALERTS_ENABLED=true
WHATSAPP_DEFAULT_PHONE="+919876543210"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
